<% layout("/layouts/boilerplate") %>
<div class="row">
   <div class="col-8 offset-2">
     <h3><%= listing.title %></h3>
      <div class="card show-card listing-card">

      <div id="listingCarousel" class="carousel slide mb-0" data-bs-ride="carousel">
        <% if (listing.images && listing.images.length > 1) { %>
        <div class="carousel-indicators">
          <% listing.images.forEach((img, i) => { %>
            <button type="button" data-bs-target="#listingCarousel" data-bs-slide-to="<%= i %>"
              class="<%= i === 0 ? 'active' : '' %>"
              aria-current="<%= i === 0 ? 'true' : 'false' %>"
              aria-label="Slide <%= i + 1 %>"></button>
          <% }) %>
        </div>
        <% } %>

        <div class="carousel-inner">
          <% listing.images.forEach((img, i) => { %>
            <div class="carousel-item <%= i === 0 ? 'active' : '' %>">
              <img src="<%= img.url %>" class="d-block w-100 show-img" alt="listing-image"/>
            </div>
          <% }) %>
        </div>

        <% if (listing.images && listing.images.length > 1) { %>
        <button class="carousel-control-prev" type="button" data-bs-target="#listingCarousel" data-bs-slide="prev">
          <span class="carousel-control-prev-icon" aria-hidden="true"></span>
          <span class="visually-hidden">Previous</span>
        </button>
        <button class="carousel-control-next" type="button" data-bs-target="#listingCarousel" data-bs-slide="next">
          <span class="carousel-control-next-icon" aria-hidden="true"></span>
          <span class="visually-hidden">Next</span>
        </button>
        <% } %>
      </div>

      <div class="card-body p-4">

        <div class="d-flex flex-wrap gap-2 mb-3">
          <span class="badge-pill badge-room"><%= listing.roomType %></span>
          <% if (listing.furnishing) { %><span class="badge-pill badge-furnish"><%= listing.furnishing %></span><% } %>
          <span class="badge-pill badge-pref-<%= listing.preferredFor || 'Any' %>"><i class="fa-solid fa-user-group"></i> <%= listing.preferredFor || "Any" %></span>
        </div>

        <div class="owner-chip">
          <span class="owner-avatar"><%= listing.owner.username.charAt(0).toUpperCase() %></span>
          Listed by <b>&nbsp;<%= listing.owner.username %></b>
        </div>

        <p class="listing-desc"> <%= listing.description %> </p>

        <div class="price-box">
          <span class="price-amount">&#8377;<%= listing.price ? listing.price.toLocaleString("en-IN") : " " %></span>
          <span class="price-period">/ month</span>
          <% if (listing.deposit) { %>
            <div class="text-muted mt-1" style="font-size:.9rem;">Security Deposit: &#8377;<%= listing.deposit.toLocaleString("en-IN") %></div>
          <% } %>
        </div>

        <% if (listing.amenities && listing.amenities.length) { %>
        <div class="mb-3">
          <div class="meta-row"><i class="fa-solid fa-list-check"></i> <b>Amenities</b></div>
          <div>
            <% listing.amenities.forEach(a => { %>
              <span class="amenity-pill"><i class="fa-solid fa-check"></i> <%= a %></span>
            <% }) %>
          </div>
        </div>
        <% } %>

        <% if (listing.availableFrom) { %>
        <div class="meta-row"><i class="fa-solid fa-calendar-check"></i> Available from <%= listing.availableFrom.toDateString() %></div>
        <% } %>

        <div class="meta-row"><i class="fa-solid fa-location-dot"></i> <%= listing.area %>, Bhopal</div>
        <div class="meta-row"><i class="fa-solid fa-map-pin"></i> <%= listing.location %></div>

        <% if (listing.contactNumber) { %>
        <a href="https://wa.me/91<%= listing.contactNumber %>?text=<%= encodeURIComponent('Hi, I am interested in your listing "' + listing.title + '" on RoomSaathi Bhopal.') %>"
           target="_blank"
           class="btn whatsapp-btn mb-3 mt-2">
           <i class="fa-brands fa-whatsapp"></i> Contact on WhatsApp
        </a>
        <% } %>

        <!-- Buttons card ke andar -->
        <% if (currUser && listing.owner._id.equals(currUser._id)) { %>
		  <div class="btns mt-3">
          <a href="/listings/<%= listing._id %>/edit"
		     class="btn btn-dark me-2 edit-btn">Edit</a>

          <form method="POST" action="/listings/<%= listing._id %>?_method=DELETE"
            class="d-inline"
            onsubmit="return confirm('Do you want to delete this listing?')">

            <button class="btn btn-dark">Delete</button>
          </form>
     </div>
        <%}%>
      <div class = "mb-3">
      <hr />
	  <% if (currUser) {%>
        <h4> Leave a Review </h4>
       <form action = "/listings/<%= listing.id %>/reviews"
          method = "POST"
	  novalidate 
	  class = "needs-validation">
	   <%# <div class ="mb-3 mt-3">
	      <label for="rating" class ="form-label" >Rating</label>
	       <input type ="range" min ="1" max ="5" id ="rating" class = "form-range" name ="review[rating]"/> 
          </div> %>

      <div class ="mb-3 mt-3">
      <fieldset class="starability-slot">
      <input
	    type="radio"
		id="no-rate"
		class="input-no-rate"
		name="review[rating]"
		value="1"
		checked
		 aria-label="No rating." />
      <input
	    type="radio"
		 id="first-rate1"
		 name="review[rating]"
		 value="1" />
      <label for="first-rate1" title="Terrible">1 star</label>
      <input
	   type="radio"
	   id="first-rate2"
	   name="review[rating]"
	   value="2" />
      <label for="first-rate2" title="Not good">2 stars</label>
      <input
	  type="radio"
	  id="first-rate3"
	  name="review[rating]"
	  value="3" />
      <label for="first-rate3" title="Average">3 stars</label>
      <input 
	  type="radio"
	  id="first-rate4"
	  name="review[rating]"
	  value="4" />
      <label for="first-rate4" title="Very good">4 stars</label>
      <input
	  type="radio" 
	  id="first-rate5" 
	  name="review[rating]"
	  value="5" />
      <label for="first-rate5" title="Amazing">5 stars</label>
   </fieldset>
	  <div class = "mb-3 mt-3">
	     <label for="comment" class ="form-label">Comments</label>
	     <textarea
	        name = "review[comment]"
		id = "comment"
		cols = "30"
		rows = "5"
		class = "form-control"
		required
		></textarea>
		<div class = "invalid-feedback"> Please add some comments for review. </div>
         </div>
	 <button class = "btn btn-outline-dark" >Submit </button>
	 </div>
	 </form>
	 <%} %>
	 </div>
	   <div class = "row">
	  <% for (review of listing.reviews) {%>
	    <div class = "card col-5 ms-3 mb-3">
	      <div class="card-body">
             <h5 class="card-title">@<%= review.author.username%></h5>
          <p class="starability-result class card-text" data-rating=<%= review.rating %>></p>   
	      <p class = "card-text"> <%= review.comment %> </p>
       
        
          <form class = "mb-3"
		       method = "POST"
			   action = "/listings/<%= listing._id %>/reviews/<%= review._id %>?_method=DELETE">
		    <button class = "btn btn-sm btn-dark"> Delete </button>
			</form>
          </div>
		  </div>
          <%}%>
		  </div>
			<div >
			  <h3> Room/Flat location </h3>
			  <div id="map"></div>
             <script>
               window.listingCoords = <%- JSON.stringify(listing.geometry?.coordinates || []) %>;
               window.listingTitle = "<%= listing.title %>";

              console.log("Coords from EJS:", window.listingCoords);
            </script>
            </div>
   </div>
  </div>
  </div>
  </div>