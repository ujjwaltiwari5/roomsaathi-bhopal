 <% layout("/layouts/boilerplate") %>

<div class="hero-banner mt-3 mb-4">
  <h1>Bhopal me apna Room ya Flat Dhundo</h1>
  <p>Students aur professionals ke liye — verified listings, area-wise search, seedha owner se WhatsApp par baat karo.</p>
</div>

<% if (allListings.length === 0) { %>
  <div class="empty-state">
    <i class="fa-solid fa-house-circle-xmark"></i>
    <h5>Koi listing nahi mili</h5>
    <p class="text-muted mb-3">Filters badal ke try karo, ya sabse pehle apni listing daalo.</p>
    <a href="/listings/new" class="btn add-btn text-white">+ List Your Room</a>
  </div>
<% } else { %>

<p class="text-muted mb-3"><%= allListings.length %> room(s)/flat(s) available</p>

<div class="row row-cols-lg-3 row-cols-md-2 row-cols-sm-1 mt-2">

<% for(let listing of allListings) { %>

<div class="col-lg-3 col-md-4 col-sm-6 mb-4">

<a href="/listings/<%= listing._id %>" class="listing-link">

<div class="card h-100 listing-card">

<div class="listing-img-wrap">
<img 
src="<%= listing.images && listing.images[0] ? listing.images[0].url : '' %>" 
class="card-img-top"
alt="listing_image"
/> 
<span class="badge-pill img-badge"><%= listing.roomType %></span>
<div class = "card-img-overlay"></div>
</div>

<div class="card-body">
<p class="card-text mb-1">
<b><%= listing.title %></b>
</p>
<p class="listing-sub mb-2"><i class="fa-solid fa-location-dot"></i> <%= listing.area %></p>
<div class="d-flex justify-content-between align-items-center">
<span class="listing-price">&#8377; <%= listing.price ? listing.price.toLocaleString("en-IN") : "" %> <small>/month</small></span>
<span class="badge-pill badge-pref-<%= listing.preferredFor || 'Any' %>"><%= listing.preferredFor || "Any" %></span>
</div>
</div>
</div>

</a>

</div>

<% } %>
</div>
<% } %>